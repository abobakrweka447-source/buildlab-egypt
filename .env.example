# REQUIRED: Replace this placeholder with a long, unpredictable secret before starting.
API_ACCESS_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
REQUIRE_API_KEY=true

PORT=8000
MAX_UPLOAD_MB=500
RETENTION_HOURS=24
MAX_PROCESS_SECONDS=7200
JOB_TIMEOUT=7200
REDIS_URL=redis://redis:6379/0

# Optional URL import: list exact HTTPS media CDN hostnames, comma-separated.
# Leave empty unless you operate/authorize the source domains. Social platform pages are not supported.
ALLOWED_DIRECT_HOSTS=

# Optional Cloudflare R2 or S3-compatible object storage. Leave all blank to use temporary local storage.
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PRESIGN_SECONDS=900
