# Keep real values in Vercel Environment Variables. Never commit real API keys.
AI_CHAT_ENABLED=false
AI_PROVIDER_ORDER=gemini,groq,huggingface

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback: Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional fallback: Hugging Face Inference Router
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
