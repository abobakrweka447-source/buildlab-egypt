# BuildLab AI — ضع القيم الحقيقية في Vercel Environment Variables فقط.
# لا ترفع ملف .env إلى GitHub ولا تضع المفاتيح في index.html.

# اتركها false أثناء الإعداد، ثم true بعد تجهيز Supabase وتشغيل ملف SQL.
AI_CHAT_ENABLED=false
AI_PROVIDER_ORDER=gemini,groq
AI_DAILY_MESSAGE_LIMIT=10
AI_MAX_OUTPUT_TOKENS=800
AI_PROVIDER_TIMEOUT_MS=18000

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq — fallback بعد Gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Supabase Auth + Database quota
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# مفاتيح Supabase القديمة مدعومة فقط لو مشروعك ما زال يستخدمها.
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
